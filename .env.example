# Backend
DATABASE_URL=postgresql://glame_user:REPLACE_WITH_UNIQUE_PASSWORD@localhost:5432/glame_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://localhost:6379
ML_INFERENCE_URL=http://localhost:8010
OPENROUTER_API_KEY=your_openrouter_api_key_here
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# YooKassa payments
# YOOKASSA_MODE can be overridden at runtime from the admin panel: test or live.
YOOKASSA_MODE=test
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=
YOOKASSA_LIVE_SHOP_ID=
YOOKASSA_LIVE_SECRET_KEY=

# Gift certificates
# Amounts are stored in kopeks. Defaults allow custom amounts from 1 000 to 100 000 RUB with a 1 RUB step.
GIFT_CERTIFICATE_MIN_AMOUNT=100000
GIFT_CERTIFICATE_MAX_AMOUNT=10000000
GIFT_CERTIFICATE_AMOUNT_STEP=100
ONEC_GIFT_CERTIFICATES_ENABLED=true
# Required for CRM-issued certificates: organization Ref_Key used in 1C gift certificate balances.
ONEC_GIFT_CERTIFICATE_ORGANIZATION_KEY=
# Optional: Ref_Key of 1C gift-certificate nomenclature with ПроизвольныйНоминал=true.
ONEC_GIFT_CERTIFICATE_ARBITRARY_REF_KEY=
# Optional: Ref_Key of 1C additional property used on certificate series to store the actual nominal.
ONEC_GIFT_CERTIFICATE_NOMINAL_PROPERTY_REF_KEY=

# AI agent runtime
# Keep legacy/OpenRouter mode unless Hermes profiles are configured.
GLAME_AGENT_RUNTIME=legacy
# AI core for BaseAgent conversations: openrouter, hermes, or local.
GLAME_AI_CORE=openrouter
GLAME_HERMES_BINARY=hermes
GLAME_HERMES_DEFAULT_PROFILE=glame-agent-worker
GLAME_HERMES_TIMEOUT_SECONDS=300
GLAME_HERMES_PROFILE_STYLIST_AGENT=glame-stylist
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.1

# 1C outbound customer creation
ONEC_REFERRAL_PARTNER_CUSTOMER_GROUP_KEY=
ONEC_CUSTOMER_GROUP_FIELD=Parent_Key
ONEC_REFERRAL_LINK_PROPERTY_KEY=

# CRM "Новое поступление": только первичный приход ассортимента из 1С на основной склад.
# Перемещения между складами/магазинами и упаковка/расходники не создают CRM-касания.
CRM_NEW_ARRIVAL_RECEIPT_SYNC_ENABLED=true
CRM_NEW_ARRIVAL_LOOKBACK_HOURS=24
CRM_NEW_ARRIVAL_LIMIT_ARRIVALS=10
CRM_NEW_ARRIVAL_LIMIT_CLIENTS_PER_ARRIVAL=25
CRM_NEW_ARRIVAL_RECEIPT_MAX_DOCUMENTS=500
ONEC_PURCHASE_RECEIPT_ENDPOINT=/Document_ПриходнаяНакладная
ONEC_PURCHASE_RECEIPT_LINES_ENDPOINT=/Document_ПриходнаяНакладная_Запасы
ONEC_MAIN_WAREHOUSE_ID=e1a2eace-fdc8-11ef-8c0c-fa163e4cc04e

# CryptoGLAME / GLM ledger maintenance
GLM_HOLD_RELEASE_SCHEDULER_ENABLED=true
GLM_HOLD_RELEASE_INTERVAL_MINUTES=60
GLM_HOLD_RELEASE_INITIAL_DELAY_SECONDS=120
GLM_HOLD_RELEASE_BATCH_LIMIT=500

# CryptoGLAME / TON Jetton testnet
TON_NETWORK=testnet
TON_GLM_JETTON_MASTER_ADDRESS=
TON_GLM_TREASURY_ADDRESS=
TON_GLM_METADATA_URL=https://partner.glamejewelry.ru/static/glm_policy/jetton-metadata-mainnet-v2.json

# CryptoGLAME primary sale / exchange desk
# User-facing coin name is GRAM; technical TON_* names remain for TON network/API compatibility.
GLM_PRIMARY_SALE_ENABLED=false
GLM_PRIMARY_SALE_RUB_PER_GLM=1
GLM_PRIMARY_SALE_MIN_GLM=100
GLM_PRIMARY_SALE_MAX_GLM=1000
GLM_PRIMARY_SALE_DAILY_LIMIT_GLM=5000
GLM_EXCHANGE_DESK_SELL_ENABLED=false
GLM_EXCHANGE_DESK_RUB_PER_GLM=1
GLM_EXCHANGE_DESK_SELL_SPREAD_PERCENT=15
GLM_EXCHANGE_DESK_MIN_GLM=100
GLM_EXCHANGE_DESK_MAX_GLM=1000
GLM_EXCHANGE_DESK_DAILY_LIMIT_GLM=5000
