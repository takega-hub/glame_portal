# Override file for /etc/glame-platform/glame-stack.env
# Copy this file to the server and adjust values if needed.

ROOT_DIR=/root/glame-platform
ADMIN_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
STOREFRONT_PORT=9092
API_BASE_URL=https://portal.glamejewelry.ru
PWA_STRATEGY=none

# Backend runtime overrides for host-based uvicorn.
DATABASE_URL=postgresql://glame_user:glame_password@127.0.0.1:5433/glame_db
QDRANT_URL=http://127.0.0.1:6333
REDIS_URL=redis://127.0.0.1:6379

# Infra bootstrap for glame-stack.service.
START_INFRA_SERVICES=true
INFRA_COMPOSE_FILE=infra/docker-compose.prod.yml
INFRA_ENV_FILE=infra/.env
INFRA_SERVICES=postgres qdrant redis ml_inference
WAIT_FOR_INFRA=true
INFRA_WAIT_TIMEOUT_SECONDS=120

# ML inference bootstrap for glame-stack service.
START_ML_INFERENCE=true
ML_INFERENCE_URL=http://127.0.0.1:8010
ML_INFERENCE_COMPOSE_FILE=infra/docker-compose.prod.yml
ML_INFERENCE_ENV_FILE=infra/.env

# CryptoGLAME / GLM ledger maintenance.
GLM_HOLD_RELEASE_SCHEDULER_ENABLED=true
GLM_HOLD_RELEASE_INTERVAL_MINUTES=60
GLM_HOLD_RELEASE_INITIAL_DELAY_SECONDS=120
GLM_HOLD_RELEASE_BATCH_LIMIT=500

# CryptoGLAME / TON Jetton testnet.
TON_NETWORK=testnet
TON_GLM_JETTON_MASTER_ADDRESS=
TON_GLM_TREASURY_ADDRESS=
TON_GLM_METADATA_URL=https://partner.glamejewelry.ru/static/glm_policy/jetton-metadata.json
TON_GLM_TRANSFER_TX_VALUE_NANOTON=30000000
TON_GLM_SETTLEMENT_WATCHER_ENABLED=false
TON_GLM_SETTLEMENT_LOOKUP_ADDRESSES=
TON_GLM_SETTLEMENT_ADMIN_USER_ID=
TON_GLM_SETTLEMENT_INTERVAL_MINUTES=15
TON_GLM_SETTLEMENT_INITIAL_DELAY_SECONDS=180
TON_GLM_SETTLEMENT_BATCH_LIMIT=50
TON_GLM_SETTLEMENT_LOOKUP_LIMIT=50
TON_GLM_SETTLEMENT_TIMEOUT_SECONDS=12
TON_GLM_SETTLEMENT_REQUIRE_MASTER_OUT_MSG=true
TONCENTER_API_BASE_URL=https://testnet.toncenter.com/api/v2
TONCENTER_API_KEY=
TON_GLM_AUTO_TRANSFER_ENABLED=false
TON_GLM_AUTO_TRANSFER_HOT_WALLET_ADDRESS=
TON_GLM_AUTO_TRANSFER_HOT_WALLET_MNEMONIC=
TON_GLM_AUTO_TRANSFER_WALLET_VERSION=v4r2
TON_GLM_AUTO_TRANSFER_ADMIN_USER_ID=
TON_GLM_AUTO_TRANSFER_MAX_AMOUNT_GLM=1000
TON_GLM_AUTO_TRANSFER_DAILY_LIMIT_GLM=5000
TON_GLM_AUTO_TRANSFER_BATCH_LIMIT=20
TON_GLM_AUTO_TRANSFER_INTERVAL_MINUTES=5
TON_GLM_AUTO_TRANSFER_INITIAL_DELAY_SECONDS=60
TON_GLM_AUTO_TRANSFER_TX_VALUE_NANOTON=50000000
TON_GLM_AUTO_TRANSFER_FORWARD_NANOTON=1
TON_GLM_AUTO_TRANSFER_SETTLEMENT_ATTEMPTS=5
TON_GLM_AUTO_TRANSFER_SETTLEMENT_DELAY_SECONDS=4

ONEC_GLM_BRIDGE_BONUS_SYNC_ENABLED=false
ONEC_GLM_BRIDGE_SPEND_SYNC_ENABLED=true
ONEC_GLM_BRIDGE_SPEND_REQUIRE_SUCCESS=true

ONEC_GLM_BRIDGE_SPEND_BONUS_PROGRAM_KEY=
ONEC_GLM_BRIDGE_SPEND_VERIFY_BALANCE=true
